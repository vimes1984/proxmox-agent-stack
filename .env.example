# ---- container layout -------------------------------------------------------
# Change these only if the ids collide with containers you already have.
CT_TWENTY=120
CT_SEMANTICA=121
CT_PAPERCLIP=122
CT_HERMES=123

CT_TEMPLATE_STORAGE=local
CT_TEMPLATE=debian-13-standard
CT_ROOTFS_STORAGE=local-lvm
CT_BRIDGE=vmbr0

# Leave empty for DHCP (recommended — the driver reads the real IP back).
# Or set fixed addresses, one per CT, e.g. STATIC_IP_TWENTY=192.168.1.120/24
STATIC_IP_TWENTY=
STATIC_IP_SEMANTICA=
STATIC_IP_PAPERCLIP=
STATIC_IP_HERMES=
GATEWAY=
DNS=1.1.1.1

# ---- resources (GB / cores) -------------------------------------------------
TWENTY_MEM=8192
TWENTY_CORES=4
TWENTY_DISK=40

SEMANTICA_MEM=4096
SEMANTICA_CORES=2
SEMANTICA_DISK=20

PAPERCLIP_MEM=8192
PAPERCLIP_CORES=4
PAPERCLIP_DISK=40

HERMES_MEM=4096
HERMES_CORES=2
HERMES_DISK=20

# ---- agent (only needed for the last step) ----------------------------------
# Any OpenAI-compatible provider key works: deepseek | openai | anthropic | openrouter
MODEL_PROVIDER=deepseek
MODEL_DEFAULT=deepseek-chat
DEEPSEEK_API_KEY=

# Optional: join a Tailscale tailnet for remote access (leave blank to skip)
TS_AUTHKEY=
TS_HOSTNAME=agent-stack-hermes
